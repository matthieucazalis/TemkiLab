generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String
  passwordHash   String
  createdAt      DateTime             @default(now())
  locale         String?
  theme          String?
  haptics        Boolean              @default(true)
  avatar         String?
  deletedAt      DateTime?
  passwordResets PasswordResetToken[]
  apiTokens      ApiToken[]
  presets        SimulationPreset[]
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  name       String
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

enum SensorType {
  FULL_FRAME
  APS_C
  MICRO_43
  MEDIUM_FORMAT
}

enum LensType {
  ZOOM
  PRIME
}

model CameraProfile {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  sensorType         SensorType
  cropFactor         Float
  nativeRatio        String
  unlockedRatios     String[]
  hasStabilization   Boolean            @default(false)
  stabilizationStops Float              @default(0)
  presets            SimulationPreset[]
}

model Lens {
  id             String             @id @default(cuid())
  brand          String
  model          String
  type           LensType
  focalMin       Int
  focalMax       Int
  maxAperture    Float
  coverage       SensorType?
  estimatedPrice Int
  priceUpdatedAt DateTime
  sourceUrl      String?
  presets        SimulationPreset[]

  @@unique([brand, model])
  @@index([brand])
  @@index([focalMin, focalMax])
}

model SimulationPreset {
  id              String         @id @default(cuid())
  name            String
  isFavorite      Boolean        @default(false)
  state           Json
  createdAt       DateTime       @default(now())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lensId          String?
  lens            Lens?          @relation(fields: [lensId], references: [id], onDelete: SetNull)
  cameraProfileId String?
  cameraProfile   CameraProfile? @relation(fields: [cameraProfileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model PairingSession {
  id             String   @id @default(cuid())
  pin            String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  failedAttempts Int      @default(0)

  @@index([expiresAt])
}